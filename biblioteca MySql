CREATE DATABASE db_biblioteca;
USE db_biblioteca;
drop database db_biblioteca;


CREATE TABLE livro (
    cod_livro INT NOT NULL,
    titulo VARCHAR(45) NOT NULL,
    PRIMARY KEY (cod_livro)
);

INSERT INTO livro (cod_livro, titulo) VALUES
(1, 'Red Queen'),
(2, 'PJO'),
(3, 'Anomalous');


CREATE TABLE autor (
    mat INT NOT NULL,
    nome VARCHAR(45) NOT NULL,
    PRIMARY KEY (mat)
);


INSERT INTO autor (mat, nome) VALUES
(1, 'Victoria'),
(2, 'Rick Riordan'),
(3, 'Daniele');


CREATE TABLE autor_livro (
    codlivro INT NOT NULL,
    mat INT NOT NULL,
    PRIMARY KEY (codlivro, mat),
    FOREIGN KEY (codlivro) REFERENCES livro(cod_livro),
    FOREIGN KEY (mat) REFERENCES autor(mat)
);


INSERT INTO autor_livro (codlivro, mat) VALUES
(1, 1),
(2, 2),
(3, 3);


SELECT livro.titulo, autor.nome
FROM livro
JOIN autor_livro
    ON livro.cod_livro = autor_livro.codlivro
JOIN autor
    ON autor_livro.mat = autor.mat;


SELECT livro.titulo, autor.nome
FROM livro, autor_livro, autor
WHERE livro.cod_livro = autor_livro.codlivro
  AND autor_livro.mat = autor.mat;


SELECT livro.titulo, autor.nome
FROM livro
JOIN autor_livro
    ON livro.cod_livro = autor_livro.codlivro
JOIN autor
    ON autor_livro.mat = autor.mat
WHERE autor.mat IN (
    SELECT mat
    FROM autor_livro
);

